{
  "extends": "@disa/tsconfig/react-app.json",
  "compilerOptions": {
    // The Vite config and its plugins import each other with a .ts extension, which is what Vite's
    // native config loader needs. Nothing under src/ does.
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src", "plugins", "vite.config.ts", "vitest.config.ts"]
}
