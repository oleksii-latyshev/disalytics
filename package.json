{
  "name": "disalytics",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "preview": "turbo run build && wrangler dev",
    "smoke": "bun tools/scripts/smoke.ts",
    "typecheck": "turbo run typecheck && tsc -p tsconfig.tools.json",
    "test": "turbo run test",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "i18n:check": "bun tools/scripts/i18n-check.ts",
    "errors:check": "bun tools/scripts/errors-check.ts",
    "wasm:build": "wasm-pack build crates/demo-parser-wasm --target web",
    "size": "bun tools/scripts/size.ts",
    "repo:labels": "bun tools/scripts/labels.ts",
    "repo:milestones": "bun tools/scripts/milestones.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@disa/demo-core": "*",
    "@types/bun": "^1.3.6",
    "lefthook": "^2.1.10",
    "turbo": "^2.10.7",
    "typescript": "5.9.2",
    "vitest": "^4.1.10",
    "wrangler": "4.118.0"
  },
  "trustedDependencies": [
    "lefthook"
  ],
  "engines": {
    "node": ">=18"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.13"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
