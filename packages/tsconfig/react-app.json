{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./base.json",
  "compilerOptions": {
    // DOM.AsyncIterable is what carries `FileSystemDirectoryHandle.keys()`, which the demo cache
    // walks to find files an interrupted write left behind.
    "lib": ["ES2023", "DOM", "DOM.Iterable", "DOM.AsyncIterable"],
    "jsx": "react-jsx",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false
  }
}
